/* Generated by chezmoi from .chezmoidata/theme.toml. Edit that file instead. */
* {
    font:       "{{ .fonts.ui }} {{ .fonts.appWeight }} {{ .fonts.size }}";
    font-large: "{{ .fonts.ui }} {{ .fonts.appWeight }} {{ .fonts.sizeLarge }}";

    bg0:        #{{ .colors.base }}{{ template "alpha" .opacity.popup }};
    bg1:        #{{ .colors.surface }}{{ template "alpha" .opacity.muted }};
    bg2:        #{{ .colors.overlay }}{{ template "alpha" .opacity.popup }};
    border0:    #{{ .colors.border }};
    border1:    #{{ .colors.borderActive }};

    fg0:        #{{ .colors.text }};
    fg1:        #{{ .colors.text }};
    fg2:        #{{ .colors.textFaint }};

    radius:     {{ .ui.radius }}px;
}
