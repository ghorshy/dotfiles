# Generated by chezmoi from .chezmoidata/theme.toml. Edit the template instead.

background {
    monitor =
    path = screenshot
    color = rgb({{ .colors.base }})
    blur_passes = 4
}

# USER NAME
label {
    monitor = DP-1
    font_family = {{ .fonts.ui }}
    text = $USER

    position = 0, 24
    halign = center
    valign = center
}


# TIME
label {
    monitor = DP-1
    font_family = {{ .fonts.ui }} Medium
    font_size = 56

    text = $TIME

    position = 0, 120
    valign = center
    halign = center
}

# DATE
label {
    monitor = DP-1
    text = cmd[update] echo -e "$(date +"%A, %d %B %Y")"
    font_family = {{ .fonts.ui }}
    font_size = 12

    position = 0, 172
    halign = center
    valign = center
}

input-field {
    monitor = DP-1
    size = 200, 32
    outline_thickness = {{ .ui.border }}
    inner_color = rgba({{ .colors.base }}40)
    dots_size = 0.25
    dots_spacing = 0.4

    outer_color = rgba({{ .colors.text }}ee)
    check_color = rgba({{ .colors.overlay }}ee)
    fail_color = rgba({{ .colors.urgent }}ee)
    capslock_color = rgba({{ .colors.warning }}ee)

    font_family = {{ .fonts.ui }}
    font_color = rgb({{ .colors.muted }})
    fade_on_empty = false
    rounding = {{ .ui.radius }}

    position = 0, -20
    halign = center
    valign = center
}
