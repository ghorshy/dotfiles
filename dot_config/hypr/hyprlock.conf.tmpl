# Generated by chezmoi from .chezmoidata/theme.toml and hosts.toml. Edit the template instead.
{{- $host := index .hosts (includeTemplate "host" .) }}

background {
    monitor =
    path = screenshot
    color = rgb({{ .colors.base }})
    blur_passes = 4
}

# USER NAME
label {
    monitor = {{ $host.lockMonitor }}
    font_family = {{ .fonts.ui }}
    text = $USER

    position = 0, 24
    halign = center
    valign = center
}


# TIME
label {
    monitor = {{ $host.lockMonitor }}
    font_family = {{ .fonts.ui }} Medium
    font_size = 56

    text = $TIME

    position = 0, 120
    valign = center
    halign = center
}

# DATE
label {
    monitor = {{ $host.lockMonitor }}
    text = cmd[update] echo -e "$(date +"%A, %d %B %Y")"
    font_family = {{ .fonts.ui }}
    font_size = 12

    position = 0, 172
    halign = center
    valign = center
}

input-field {
    monitor = {{ $host.lockMonitor }}
    size = 200, 32
    outline_thickness = {{ .ui.border }}
    inner_color = rgba({{ .colors.base }}{{ template "alpha" .opacity.hover }})
    dots_size = 0.25
    dots_spacing = 0.4

    outer_color = rgba({{ .colors.text }}{{ template "alpha" .opacity.popup }})
    check_color = rgba({{ .colors.overlay }}{{ template "alpha" .opacity.popup }})
    fail_color = rgba({{ .colors.urgent }}{{ template "alpha" .opacity.popup }})
    capslock_color = rgba({{ .colors.warning }}{{ template "alpha" .opacity.popup }})

    font_family = {{ .fonts.ui }}
    font_color = rgb({{ .colors.textFaint }})
    fade_on_empty = false
    rounding = {{ .ui.radius }}

    position = 0, -20
    halign = center
    valign = center
}
