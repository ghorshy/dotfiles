-- Generated by chezmoi from .chezmoidata/theme.toml. Edit that file instead.
{{- $c := .colors }}
return {
	active_border = "rgba({{ $c.borderActive }}{{ template "alpha" .opacity.popup }})",
	inactive_border = "rgba({{ $c.border }}{{ template "alpha" .opacity.active }})",
	shadow = "rgba({{ $c.shadow }}{{ template "alpha" .opacity.shadow }})",
	shadow_range = {{ .ui.shadowRange }},
	shadow_power = {{ .ui.shadowPower }},
	rounding = {{ .ui.radius }},
	border_size = {{ .ui.border }},
	gaps_in = {{ .ui.gapsIn }},
	gaps_out = {{ .ui.gapsOut }},
	ease_out_quint = { { {{ index .animation.curve 0 }}, {{ index .animation.curve 1 }} }, { {{ index .animation.curve 2 }}, {{ index .animation.curve 3 }} } },
}
