//@ pragma UseQApplication
//@ pragma IconTheme {{ .ui.iconTheme }}

import QtQuick
import Quickshell
import Quickshell.Io
import qs.bar
import qs.notifications
import qs.osd
import qs.powermenu
import qs.common

ShellRoot {
    Variants {
        model: Quickshell.screens

        delegate: Component {
            Bar {}
        }
    }

    Notifications {}
    BatteryWarnings {}

    // qs ipc call popups toggle network|bluetooth|calendar (on the focused monitor)
    IpcHandler {
        target: "popups"

        function toggle(name: string): void {
            Popups.toggle(`${name}@${Screens.focused?.name}`);
        }
    }
    Osd {}
    PowerMenu {}
}
